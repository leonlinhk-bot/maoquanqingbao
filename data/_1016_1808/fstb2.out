			<td style="width:229px">0</td>
		</tr>
		<tr>
			<td style="width:229px">重慶海外聯誼會&mdash;在渝港澳企業家分會</td>
			<td style="width:230px">0</td>
			<td style="width:229px">1（共1名獲提名人士）</td>
		</tr>
		<tr>
			<td style="width:229px">福建省僑商聯合會</td>
			<td style="width:230px">1（共1名獲提名人士）</td>
			<td style="width:229px">1（共1名獲提名人士）</td>
