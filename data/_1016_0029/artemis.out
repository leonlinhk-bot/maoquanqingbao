		<title>Traditional reinsurance still the backbone despite alternative capital influx: Munich Re’s Blunck</title>
		<link>https://www.artemis.bm/news/traditional-reinsurance-still-the-backbone-despite-alternative-capital-influx-munich-res-blunck/?utm_source=rss&#038;utm_medium=rss&#038;utm_campaign=traditional-reinsurance-still-the-backbone-despite-alternative-capital-influx-munich-res-blunck</link>
		
		<dc:creator><![CDATA[Kassandra Jimenez-Sanchez]]></dc:creator>
		<pubDate>Thu, 15 Oct 2026 10:30:32 +0000</pubDate>
				<category><![CDATA[News]]></category>
