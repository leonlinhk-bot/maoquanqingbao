		<title>Liberty Mutual Re makes sensor-triggered parametric earthquake payout in Mexico</title>
		<link>https://www.artemis.bm/news/liberty-mutual-re-makes-sensor-triggered-parametric-earthquake-payout-in-mexico/?utm_source=rss&#038;utm_medium=rss&#038;utm_campaign=liberty-mutual-re-makes-sensor-triggered-parametric-earthquake-payout-in-mexico</link>
		
		<dc:creator><![CDATA[Jack Willard]]></dc:creator>
		<pubDate>Tue, 13 Oct 2026 09:45:23 +0000</pubDate>
				<category><![CDATA[News]]></category>
