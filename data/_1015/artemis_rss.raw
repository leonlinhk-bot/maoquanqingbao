		<item>
		<title>Evolving captives becoming strategic platforms for attracting third-party capital: Aon</title>
		<link>https://www.artemis.bm/news/evolving-captives-becoming-strategic-platforms-for-attracting-third-party-capital-aon/?utm_source=rss&#038;utm_medium=rss&#038;utm_campaign=evolving-captives-becoming-strategic-platforms-for-attracting-third-party-capital-aon</link>
		
		<dc:creator><![CDATA[Jack Willard]]></dc:creator>
		<pubDate>Tue, 13 Oct 2026 08:00:19 +0000</pubDate>
				<category><![CDATA[Insurance Linked Investments]]></category>
		<category><![CDATA[News]]></category>
		<category><![CDATA[Alternative reinsurance capital]]></category>
		<category><![CDATA[capital markets]]></category>
