			<td style="height:17px; width:76px">25/86</td>
		</tr>
		<tr>
			<td style="height:17px; width:180px">Environment and Conservation</td>
			<td style="height:17px; width:94px">0/0</td>
			<td style="height:17px; width:76px">1/2</td>
			<td style="height:17px; width:76px">2/4</td>
		</tr>
		<tr>
			<td rowspan="2" style="height:17px; width:142px">Transportation</td>
			<td style="height:17px; width:180px">Automobile</td>
			<td style="height:17px; width:94px">16/105</td>
			<td style="height:17px; width:76px">20/89</td>
			<td style="height:17px; width:76px">11/64</td>
		</tr>
		<tr>
			<td style="height:17px; width:180px">Aviation</td>
			<td style="height:17px; width:94px">0/0</td>
			<td style="height:17px; width:76px">0/0</td>
			<td style="height:17px; width:76px">0/0</td>
		</tr>
		<tr>
			<td rowspan="2" style="height:17px; width:142px">Design, Jewellery, Creative Industry&nbsp;</td>
			<td style="height:17px; width:180px">Design and Printing</td>
			<td style="height:17px; width:94px">3/3</td>
			<td style="height:17px; width:76px">1/2</td>
			<td style="height:17px; width:76px">0/0</td>
		</tr>
		<tr>
			<td style="height:17px; width:180px">Jewellery and Watches</td>
			<td style="height:17px; width:94px">1/2</td>
			<td style="height:17px; width:76px">1/2</td>
			<td style="height:17px; width:76px">0/0</td>
		</tr>
		<tr>
			<td style="height:16px; width:142px">Healthcare Services</td>
			<td style="height:16px; width:180px">Healthcare Services&nbsp;</td>
			<td style="height:16px; width:94px">8/18</td>
			<td style="height:16px; width:76px">2/4</td>
