 Subscriber? Please <a href=\"https:\/\/insuranceasianews.com\/login\/\">Login<\/a><\/p>\n<\/div>\n  <\/div>\n  <div class=\"mepr-login-form-wrap\">\n      <\/div>\n<\/div>\n","protected":false},"excerpt":{"rendered":"<p>The target was formerly FWD General Insurance and was divested by the Richard Li-controlled insurance group to bolttech in 2020.<\/p>\n","protected":false},"author":6035,"featured_media":230782,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":{"_acf_changed":false,"content-type":"","footnotes":""},"companies_category":[313,867],"subject":[67],"line_of_business":[],"topic":[],"coauthors":[534],"class_list":["post-230781","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","industry_segments-insurers","industry_segments-property-casualty","country-hong-kong","companies_category-bolttech","companies_category-fwd-group","subject-ma"],"acf":[],"yoast_head":"<!-- This site is optimized with the Yoast SEO plugin v28.6 - https:\/\/yoast.com\/product\/yoast-seo-wordpress\/ -->\n<title>FWD to re-enter P&amp;C with 25% stake in bolttech Hong Kong for US$21m<\/title>\n<meta name=\"description\" content=\"The key resource for accurate, insightful and reliable coverage of Asia\u2019s insurance and reinsurance market.\" \/>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/insuranceasianews.com\/fwd-to-acquire-25-of-hong-kong-pc-carrier-bolttech-insurance-for-us21m\/\" \/>\n<meta property=\"og:locale\" content=\"en_US\" \/>\n<meta property=\"og:type\" content=\"article\" \/>\n<meta property=\"og:title\" content=\"FWD to re-enter P&amp;C with 25% stake in bolttech Hong Kong for US$21m\" \/>\n<meta property=\"og:description\" content=\"The key resource for accurate, insightful and reliable coverage of Asia\u2019s insurance and reinsurance market.\" \/>\n<meta property=\"og: