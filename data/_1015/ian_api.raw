\/{rel}","templated":true}]}}]]}},{"id":230722,"date":"2026-10-11T12:58:00","date_gmt":"2026-10-11T04:58:00","guid":{"rendered":"https:\/\/insuranceasianews.com\/?p=230722"},"modified":"2026-10-11T13:26:14","modified_gmt":"2026-10-11T05:26:14","slug":"australias-competition-tribunal-halts-iag-raci-appeal-pending-accc-public-benefit-ruling","status":"publish","type":"post","link":"https:\/\/insuranceasianews.com\/australias-competition-tribunal-halts-iag-raci-appeal-pending-accc-public-benefit-ruling\/","title":{"rendered":"Australia\u2019s competition tribunal halts IAG-RACI appeal pending ACCC public benefit ruling"},"content":{"rendered":"<div class=\"mp_wrapper\">\n  <div class=\"mepr-unauthorized-excerpt\">\n    <p>The Australian Competition Tribunal (ACT) will suspend its review of IAG's proposed acquisition  of RAC Insurance (RACI) until the Australian Competition and Consumer Commission (ACCC) determines a pu...<\/p>\n  <\/div>\n  <div class=\"mepr-unauthorized-message\">\n    <div class=\"mepr-wrapper\">\n<p>To continue reading the full article and get full access to the InsuranceAsia News platform, please enquire about a subscription.<\/p>\n<p>Your company may already have a corporate license in place.<\/p>\n<div class=\"mepr-button-wrap\">\n<p><a href=\"https:\/\/insuranceasianews.com\/subscribe\/\">Enquire Now<\/a><\/p>\n<div>OR<\/div>\n<p>      <a href=\"https:\/\/insuranceasianews.com\/register\/free-trial\/\" class=\"mepr_product_link mepr-product-link-63661\">Take a Free Trial<\/a>\n        <\/p>\n<\/div>\n<p>Already a Subscriber? Please <a href=\"https:\/\/insuranceasianews.com\/login\/\">Login<\/a><\/p>\n<\/div>\n  <\/div>\n  <div class=\"mepr-login-form-wrap\">\n      <\/div>\n<\/div>\n","protected":false},"excerpt":{"rendered":"<p>IAG and RACWA plan to file the public benefit application with the competition watchdog before Wednesday.<\/p>\n","protected":false},"author":6035,"featured_media":199169,"comment_status":"closed","ping_status":"closed",