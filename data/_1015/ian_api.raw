<\/div>\n<p>      <a href=\"https:\/\/insuranceasianews.com\/register\/free-trial\/\" class=\"mepr_product_link mepr-product-link-63661\">Take a Free Trial<\/a>\n        <\/p>\n<\/div>\n<p>Already a Subscriber? Please <a href=\"https:\/\/insuranceasianews.com\/login\/\">Login<\/a><\/p>\n<\/div>\n  <\/div>\n  <div class=\"mepr-login-form-wrap\">\n      <\/div>\n<\/div>\n","protected":false},"excerpt":{"rendered":"<p>The partial suspension, running from Tuesday to the end of January, bars the insurers from writing new contracts or selling products.<\/p>\n","protected":false},"author":11026,"featured_media":230154,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":{"_acf_changed":false,"content-type":"","footnotes":""},"companies_category":[835],"subject":[865],"line_of_business":[],"topic":[],"coauthors":[882],"class_list":["post-230729","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","industry_segments-insurers","industry_segments-regulators","country-japan","companies_category-financial-services-agency","subject-life"],"acf":[],"yoast_head":"<!-- This site is optimized with the Yoast SEO plugin v28.6 - https:\/\/yoast.com\/product\/yoast-seo-wordpress\/ -->\n<title>Japan&#039;s FSA suspends Prudential Life, Gibraltar Life operations for 3 months over employee fraud<\/title>\n<meta name=\"description\" content=\"The key resource for accurate, insightful and reliable coverage of Asia\u2019s insurance and reinsurance market.\" \/>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/insuranceasianews.com\/japans-fsa-suspends-prudential-life-gibraltar-life-operations-for-3-months-over-employee-fraud\/\" \/>\n<meta property=\"og:locale\" content=\"en_US\" \/>\n<meta property=\"og:type\" content=\"article\" \/>\n<meta property=\"og:title\" content=\"Japan&#039;s FSA suspends Prude