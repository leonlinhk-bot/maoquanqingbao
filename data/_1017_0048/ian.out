[{"id":231202,"date":"2026-10-16T17:25:54","date_gmt":"2026-10-16T09:25:54","guid":{"rendered":"https:\/\/insuranceasianews.com\/?p=231202"},"modified":"2026-10-16T17:25:54","modified_gmt":"2026-10-16T09:25:54","slug":"kiwi-broker-donaldson-brown-promotes-jared-sun-to-head-of-financial-lines","status":"publish","type":"post","link":"https:\/\/insuranceasianews.com\/kiwi-broker-donaldson-brown-promotes-jared-sun-to-head-of-financial-lines\/","title":{"rendered":"Kiwi broker Donaldson Brown promotes Jared Sun to head of financial lines"},"content":{"rendered":"<div class=\"mp_wrapper\">\n  <div class=\"mepr-unauthorized-excerpt\">\n    <p>Kiwi broker Donaldson Brown has promoted Jared Sun to head of financial lines, according to a LinkedIn update.\nAuckland-based Sun has over 10 years of experience in the insurance industry, working acr...<\/p>\n  <\/div>\n  <div class=\"mepr-unauthorized-message\">\n    <div class=\"mepr-wrapper\">\n<p>To continue reading the full article and get full access to the InsuranceAsia News platform, please enquire about a subscription.<\/p>\n<p>Your company may already have a corporate license in place.<\/p>\n<div class=\"mepr-button-wrap\">\n<p><a href=\"https:\/\/insuranceasianews.com\/subscribe\/\">Enquire Now<\/a><\/p>\n<div>OR<\/div>\n<p>      <a href=\"https:\/\/insuranceasianews.com\/register\/free-trial\/\" class=\"mepr_product_link mepr-product-link-63661\">Take a Free Trial<\/a>\n        <\/p>\n<\/div>\n<p>Already a Subscriber? Please <a href=\"https:\/\/insuranceasianews.com\/login\/\">Login<\/a><\/p>\n<\/div>\n  <\/div>\n  <div class=\"mepr-login-form-wrap\">\n      <\/div>\n<\/div>\n","protected":false},"excerpt":{"rendered":"<p>He has over 10 years of insurance experience, including four years with Donaldson Brown, where he was most recently a risk adviser for financial lines.<\/p>\n","protected":false},"author":9598,"featured_media":231203,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format"