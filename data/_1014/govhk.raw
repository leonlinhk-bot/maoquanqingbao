			<td style="height:26px; width:37.8%">3.4</td>
		</tr>
		<tr>
			<td style="height:26px; width:22.48%">二○一八</td>
			<td style="height:26px; width:39.72%">1.0</td>
			<td style="height:26px; width:37.8%">3.4</td>
		</tr>
		<tr>
			<td style="height:26px; width:22.48%">二○一七</td>
			<td style="height:26px; width:39.72%">1.4</td>
			<td style="height:26px; width:37.8%">4.7</td>
		</tr>
		<tr>
			<td style="height:26px; width:22.48%">二○一六</td>
