    <!-- Snippet: kMoOR0JCw -->
<script>
(() => {
  if (window.__hkfiLanguageNavigation) return;
  window.__hkfiLanguageNavigation = true;

  const hosts = new Set([
    "www.hkfi.org.hk",
    "information-corner.hkfi.org.hk"
  ]);

  // 记录原始地址，避免切换语言后残留上次添加的前缀
  const originals = new WeakMap();

  function currentPrefix() {
    const path = location.pathname;
    if (/^\/zh-cn(?:\/|$)/i.test(path)) return "/zh-cn";
    if (/^\/zh(?:\/|$)/i.test(path)) return "/zh";
    return "";
  }

  function resolveLink(link) {
    const raw = link.getAttribute("href");
    if (!raw) return null;

    let record = originals.get(link);
    if (!record || raw !== record.applied) {
      record = { original: raw, applied: raw };
      originals.set(link, record);
    }

    const source = record.original;

    if (
      source.startsWith("#") ||
      link.hasAttribute("download") ||
      link.hasAttribute("hreflang")
    ) return null;

    let url;
    try {
      url = new URL(source, location.href);
    } catch {
      return null;
    }

    if (
      !["http:", "https:"].includes(url.protocol) ||
      !hosts.has(url.hostname) ||
      url.searchParams.get("hkfi-locale") === "off"
    ) return null;

    const basePath =
      url.pathname.replace(/^\/(?:zh-cn|zh)(?=\/|$)/i, "") || "/";

    // 排除文件和接口
    if (
      /\/[^/]+\.[^/]+$/.test(basePath) ||
      /^\/(?:api|\.well-known)(?:\/|$)/i.test(basePath)
    ) return null;

    // 同网站原本明确指定语言的链接保持原样
    if (
      url.hostname === location.hostname &&
      /^\/(?:zh-cn|zh)(?:\/|$)/i.test(url.pathname)
    ) return null;

    const before = url.href;
    url.pathname = currentPrefix() + basePath;

    record.applied = url.href;
    if (link.getAttribute("href") !== url.href) {
      link.setAttribute("href", url.href);
    }

    return {
      url: url.href,
      needsCorrection: url.href !== before
    };
  }

  function eventLink(event) {
    return event.target instanceof Element
      ? event.target.closest("a[href]")
      : null;
  }

  // 在悬停、触摸、键盘聚焦和右键打开之前更新地址
  ["pointerover", "pointerdown", "focusin", "contextmenu"]
    .forEach(type => {
      document.addEventListener(type, event => {
        const link = eventLink(event);
        if (link) resolveLink(link);
      }, true);
    });

  document.addEventListener("click", event => {
    if (event.defaultPrevented || event.button !== 0) return;

    const link = eventLink(event);
    if (!link) return;

    const result = resolveLink(link);
    if (!result || !result.needsCorrection) return;

    // 阻止其他点击处理器继续使用原来的英文地址
    event.stopImmediatePropagation();

    // 组合键或新窗口链接，保留浏览器的原生行为
    const target = (link.getAttribute("target") || "").toLowerCase();
    if (
      event.ctrlKey || event.metaKey ||
      event.shiftKey || event.altKey ||
      (target && target !== "_self")
    ) return;

    event.preventDefault();
    location.assign(result.url);
  }, true);
})();
</script>
<!-- SnippetEnd: kMoOR0JCw -->

