blank"><img src="https://gia.info.gov.hk/general/202610/07/P2026100600422_photo_1340379.jpg" style="max-width:320px;max-height:320px" alt="Photo" border="1" /></a>&nbsp;&nbsp;<a href="https://gia.info.gov.hk/general/202610/07/P2026100600422_photo_1340380.jpg" target="_blank"><img src="https://gia.info.gov.hk/general/202610/07/P2026100600422_photo_1340380.jpg" style="max-width:320px;max-height:320px" alt="Photo" border="1" /></a>&nbsp;&nbsp;<a href="https://gia.info.gov.hk/general/202610/07/P2026100600422_photo_1340381.jpg" target="_blank"><img src="https://gia.info.gov.hk/general/202610/07/P2026100600422_photo_1340381.jpg" style="max-width:320px;max-height:320px" alt="Photo" border="1" /></a>&nbsp;&nbsp;<a href="https://gia.info.gov.hk/general/202610/07/P2026100600422_photo_1340382.jpg" target="_blank"><img src="https://gia.info.gov.hk/general/202610/07/P2026100600422_photo_1340382.jpg" style="max-width:320px;max-height:320px" alt="Photo" border="1" /></a>&nbsp;&nbsp;<a href="https://gia.info.gov.hk/general/202610/07/P2026100600422_photo_1340383.jpg" target="_blank"><img src="https://gia.info.gov.hk/general/202610/07/P2026100600422_photo_1340383.jpg" style="max-width:320px;max-height:320px" alt="Photo" border="1" /></a>&nbsp;&nbsp;</div>]]></description></item></channel></rss>