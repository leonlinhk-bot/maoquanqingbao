		<title>Higher short-term rates boost ILS returns, reshape hedge fund attribution: Agecroft’s Steinbrugge</title>
		<link>https://www.artemis.bm/news/higher-short-term-rates-boost-ils-returns-reshape-hedge-fund-attribution-agecrofts-steinbrugge/?utm_source=rss&#038;utm_medium=rss&#038;utm_campaign=higher-short-term-rates-boost-ils-returns-reshape-hedge-fund-attribution-agecrofts-steinbrugge</link>
		
		<dc:creator><![CDATA[Jack Willard]]></dc:creator>
		<pubDate>Thu, 08 Oct 2026 08:00:23 +0000</pubDate>
				<category><![CDATA[Insurance Linked Investments]]></category>
