		<title>From hard market to normalisation &#8211; Cat bond discipline in practice: Artemis London 2026 video</title>
		<link>https://www.artemis.bm/news/from-hard-market-to-normalisation-cat-bond-discipline-in-practice-artemis-london-2026-video/?utm_source=rss&#038;utm_medium=rss&#038;utm_campaign=from-hard-market-to-normalisation-cat-bond-discipline-in-practice-artemis-london-2026-video</link>
		
		<dc:creator><![CDATA[Steve Evans]]></dc:creator>
		<pubDate>Thu, 08 Oct 2026 13:00:53 +0000</pubDate>
				<category><![CDATA[Artemis.bm]]></category>
