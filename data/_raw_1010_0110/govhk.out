			<td style="height:23px; width:254px">洪聖爺灣泳灘＊</td>
			<td style="height:23px; width:310px">赤柱正灘泳灘＊</td>
		</tr>
		<tr>
			<td style="height:23px; width:254px">加多利灣泳灘＊</td>
			<td style="height:23px; width:310px">大埔龍尾泳灘＊</td>
		</tr>
		<tr>
			<td style="height:23px; width:254px">橋咀泳灘</td>
